<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>AudioFlow.Updater</RootNamespace>
    <AssemblyName>AudioFlow.Updater</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Description>Standalone updater for AudioFlow. Verifies the package, backs up user data and applies the update.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AudioFlow.Configuration\AudioFlow.Configuration.csproj" />
    <ProjectReference Include="..\AudioFlow.Updates\AudioFlow.Updates.csproj" />
  </ItemGroup>

</Project>
