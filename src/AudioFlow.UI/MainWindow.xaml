<Window x:Class="AudioFlow.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AudioFlow.UI.Localization"
        Title="AudioFlow"
        Height="820" Width="1240"
        MinHeight="680" MinWidth="1040"
        Background="#0B0D10"
        Foreground="#E8ECF1"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#12161C" />
        <SolidColorBrush x:Key="SurfaceAlt" Color="#171C22" />
        <SolidColorBrush x:Key="Border" Color="#1E242D" />
        <SolidColorBrush x:Key="TextPrimary" Color="#E8ECF1" />
        <SolidColorBrush x:Key="TextSecondary" Color="#8A94A6" />
        <SolidColorBrush x:Key="Accent" Color="#4F8CFF" />
        <SolidColorBrush x:Key="Success" Color="#38D39F" />
        <SolidColorBrush x:Key="Warning" Color="#F5B84B" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="#161B22" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D242E" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#06101F" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{StaticResource SurfaceAlt}"
                                                BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="9">
                                            <TextBlock Text="&#x25BE;" Foreground="{StaticResource TextSecondary}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,7,30,7" VerticalAlignment="Center" />
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}"
                                        BorderThickness="1" CornerRadius="9" Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D2A3F" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22314A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <!-- Sidebar navigation -->
        <Style x:Key="NavTabControl" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="224" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#0E1116" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                                <StackPanel Margin="0,14,0,0">
                                    <TabPanel IsItemsHost="True" />
                                </StackPanel>
                            </Border>
                            <ContentPresenter Grid.Column="1" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" Margin="10,3" CornerRadius="10" Padding="12,11">
                            <Grid>
                                <Border x:Name="Bar" Width="3" Height="16" HorizontalAlignment="Left"
                                        CornerRadius="2" Background="Transparent" />
                                <ContentPresenter ContentSource="Header" Margin="16,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#141C27" />
                                <Setter TargetName="Bar" Property="Background" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#11161D" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="Background" Value="#121821" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0E1116" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="22,15">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="10" Background="#12315E">
                        <TextBlock Text="AF" Foreground="#8FBCFF" FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Tr AppTitle}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Tr AppSubtitle}" Style="{StaticResource Muted}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusPill}" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#5A6472" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RoutingEnabled}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Button Content="{loc:Tr BtnApplyNow}" Command="{Binding ApplyNowCommand}"
                            Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                    <Button Content="{loc:Tr BtnRefresh}" Command="{Binding RefreshCommand}"
                            Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                    <Button Content="{Binding StartStopText}" Command="{Binding StartStopCommand}"
                            Style="{StaticResource PrimaryButton}" MinWidth="92" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" TabStripPlacement="Left" Background="Transparent" BorderThickness="0"
                    Style="{StaticResource NavTabControl}">

            <!-- DASHBOARD -->
            <TabItem Style="{StaticResource NavTabItem}">
                <TabItem.Header><TextBlock Text="{loc:Tr NavDashboard}" /></TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:Tr SectionOutputDevices}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr Speakers}" Style="{StaticResource Muted}" />
                                    <ComboBox Margin="0,6,0,14" ItemsSource="{Binding OutputDevices}"
                                              SelectedItem="{Binding SpeakersDevice}" DisplayMemberPath="DisplayName" />
                                    <TextBlock Text="{loc:Tr Headphones}" Style="{StaticResource Muted}" />
                                    <ComboBox Margin="0,6,0,0" ItemsSource="{Binding OutputDevices}"
                                              SelectedItem="{Binding HeadphonesDevice}" DisplayMemberPath="DisplayName" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr DefaultOutput}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{Binding HeadphonesDeviceName}" FontSize="20" FontWeight="SemiBold"
                                               Foreground="{StaticResource Accent}" Margin="0,8,0,4" />
                                    <TextBlock Text="{loc:Tr DefaultOutputHint}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{loc:Tr AudioLock}" Style="{StaticResource SectionTitle}" />
                                        <CheckBox HorizontalAlignment="Right" IsChecked="{Binding AudioLockEnabled}" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                                        <Border Background="#2A2210" CornerRadius="6" Padding="8,3">
                                            <TextBlock Text="{loc:Tr AudioLockPartial}" Foreground="{StaticResource Warning}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text="{Binding AudioLockStateText}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                    </StackPanel>
                                    <TextBlock Text="{loc:Tr AudioLockHint}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{loc:Tr FlowTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <ItemsControl ItemsSource="{Binding DetectedApps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5">
                                                <TextBlock Text="{Binding Name}" FontSize="13" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Text="&#x2192;" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding TargetDeviceName}" FontSize="13" Foreground="{StaticResource Accent}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <TextBlock Text="{loc:Tr SectionActiveApplications}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                            <Border Style="{StaticResource Card}">
                                <ItemsControl ItemsSource="{Binding DetectedApps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceAlt}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" />
                                                    </StackPanel>
                                                    <Button HorizontalAlignment="Right" Content="{loc:Tr AddToSpeakers}"
                                                            Command="{Binding DataContext.AddToSpeakersCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOnSpeakers}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="False" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- APPLICATIONS -->
            <TabItem Style="{StaticResource NavTabItem}">
                <TabItem.Header><TextBlock Text="{loc:Tr NavApplications}" /></TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr ApplicationsTitle}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Tr ApplicationsHint}" Style="{StaticResource Muted}" Margin="0,4,0,18" />
                        <ItemsControl ItemsSource="{Binding DetectedApps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding ProcessName}" Style="{StaticResource Muted}" />
                                                    <TextBlock Text="  ·  " Style="{StaticResource Muted}" />
                                                    <TextBlock Text="{Binding TargetDeviceName}" Style="{StaticResource Muted}" Foreground="{StaticResource Accent}" />
                                                    <TextBlock Text="  ·  " Style="{StaticResource Muted}" />
                                                    <TextBlock Text="{Binding RuleLabel}" Style="{StaticResource Muted}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Content="{loc:Tr AddToSpeakers}"
                                                    Command="{Binding DataContext.AddToSpeakersCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnSpeakers}" Value="True">
                                                                <Setter Property="IsEnabled" Value="False" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- RULES -->
            <TabItem Style="{StaticResource NavTabItem}">
                <TabItem.Header><TextBlock Text="{loc:Tr NavRules}" /></TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr RulesTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18" />
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr DefaultRule}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{loc:Tr DefaultRuleHint}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding HeadphonesDeviceName}" FontSize="16" Foreground="{StaticResource Accent}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{loc:Tr ExplicitRules}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr NoRules}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SpeakerApps.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding SpeakerApps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceAlt}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Key}" Style="{StaticResource Muted}" />
                                                    </StackPanel>
                                                    <Button HorizontalAlignment="Right" Content="{loc:Tr BtnRemove}"
                                                            Style="{StaticResource SmallButton}"
                                                            Command="{Binding DataContext.RemoveFromSpeakersCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- DEVICES -->
            <TabItem Style="{StaticResource NavTabItem}">
                <TabItem.Header><TextBlock Text="{loc:Tr NavDevices}" /></TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr DevicesTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18" />
                        <ItemsControl ItemsSource="{Binding OutputDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="{Binding Id}" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- DIAGNOSTICS -->
            <TabItem Style="{StaticResource NavTabItem}">
                <TabItem.Header><TextBlock Text="{loc:Tr NavDiagnostics}" /></TabItem.Header>
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="180" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <Grid>
                            <TextBlock Text="{loc:Tr DiagnosticsTitle}" FontSize="20" FontWeight="SemiBold" />
                            <Button HorizontalAlignment="Right" Content="{loc:Tr BtnOpenLogs}"
                                    Command="{Binding OpenLogsCommand}" Style="{StaticResource SmallButton}" />
                        </Grid>
                        <TextBlock Text="{loc:Tr DiagnosticsHint}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="6,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Tr ColProcess}" Style="{StaticResource Muted}" />
                                    <TextBlock Grid.Column="1" Text="{loc:Tr ColPid}" Style="{StaticResource Muted}" />
                                    <TextBlock Grid.Column="2" Text="{loc:Tr ColDevice}" Style="{StaticResource Muted}" />
                                    <TextBlock Grid.Column="3" Text="{loc:Tr ColState}" Style="{StaticResource Muted}" />
                                    <TextBlock Grid.Column="4" Text="{loc:Tr ColVolume}" Style="{StaticResource Muted}" />
                                    <TextBlock Grid.Column="5" Text="{loc:Tr ColPeak}" Style="{StaticResource Muted}" />
                                    <TextBlock Grid.Column="6" Text="{loc:Tr ColRouting}" Style="{StaticResource Muted}" />
                                    <TextBlock Grid.Column="7" Text="{loc:Tr ColVerified}" Style="{StaticResource Muted}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Diagnostics}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="6,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="100" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Process}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Pid}" FontSize="12" />
                                                <TextBlock Grid.Column="2" Text="{Binding Device}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{Binding State}" FontSize="12" />
                                                <TextBlock Grid.Column="4" Text="{Binding Volume}" FontSize="12" />
                                                <TextBlock Grid.Column="5" Text="{Binding Peak}" FontSize="12" />
                                                <TextBlock Grid.Column="6" Text="{Binding Routing}" FontSize="12" />
                                                <TextBlock Grid.Column="7" Text="{Binding Verified}" FontSize="12" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Grid.Row="2" Text="{loc:Tr LogsTitle}" Style="{StaticResource SectionTitle}" Margin="0,14,0,8" />
                    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="10">
                        <ListBox ItemsSource="{Binding LogLines}" Background="Transparent" BorderThickness="0"
                                 FontFamily="Consolas" FontSize="11" Foreground="#9AA6B8" />
                    </Border>
                </Grid>
            </TabItem>

            <!-- SETTINGS -->
            <TabItem Style="{StaticResource NavTabItem}">
                <TabItem.Header><TextBlock Text="{loc:Tr NavSettings}" /></TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr SettingsTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18" />

                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr SettingsGeneral}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{loc:Tr Language}" Style="{StaticResource Muted}" Margin="0,12,0,0" />
                                <ComboBox Width="240" HorizontalAlignment="Left" Margin="0,6,0,0"
                                          ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                                          DisplayMemberPath="Label" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr SettingsStartup}" Style="{StaticResource SectionTitle}" />
                                <CheckBox Content="{loc:Tr StartWithWindows}" IsChecked="{Binding StartWithWindows}" Margin="0,12,0,0" />
                                <CheckBox Content="{loc:Tr CheckForUpdatesOnStartup}" IsChecked="{Binding CheckForUpdatesEnabled}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr SettingsUpdates}" Style="{StaticResource SectionTitle}" />
                                <Grid Margin="0,12,0,0">
                                    <TextBlock Text="{loc:Tr UpdateCurrentVersionLabel}" Style="{StaticResource Muted}" />
                                    <TextBlock Text="{Binding UpdateCurrentVersion}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <TextBlock Text="{loc:Tr UpdateLatestVersionLabel}" Style="{StaticResource Muted}" />
                                    <TextBlock Text="{Binding UpdateLatestVersion}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <TextBlock Text="{loc:Tr UpdateStatusLabel}" Style="{StaticResource Muted}" />
                                    <TextBlock Text="{Binding UpdateStatusText}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <TextBlock Text="{loc:Tr UpdateLastCheckedLabel}" Style="{StaticResource Muted}" />
                                    <TextBlock Text="{Binding LastChecked}" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="{Binding UpdateMessage}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="{loc:Tr BtnCheckForUpdates}" Command="{Binding CheckForUpdatesCommand}"
                                            Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                                    <Button Content="{loc:Tr BtnUpdateNow}" Command="{Binding UpdateNowCommand}" Margin="0,0,8,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{loc:Tr BtnOpenReleases}" Command="{Binding OpenReleasesCommand}"
                                            Style="{StaticResource GhostButton}" />
                                </StackPanel>
                                <TextBlock Text="{loc:Tr UpdatesNote}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr About}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{loc:Tr AboutText}" Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                <Grid Margin="0,12,0,0">
                                    <TextBlock Text="{loc:Tr Version}" Style="{StaticResource Muted}" />
                                    <TextBlock Text="{Binding AppVersionText}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <TextBlock Text="{loc:Tr License}" Style="{StaticResource Muted}" />
                                    <TextBlock Text="MIT" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <TextBlock Text="{loc:Tr Repository}" Style="{StaticResource Muted}" />
                                    <TextBlock Text="github.com/JavierparraDev/audioflow" HorizontalAlignment="Right"
                                               Foreground="{StaticResource Accent}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
