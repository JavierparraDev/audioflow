<Window x:Class="AudioFlow.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudioFlow"
        Height="760" Width="1120"
        MinHeight="640" MinWidth="900"
        Background="#12121C"
        Foreground="#F2F2F7"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#1E1E2E" />
        <SolidColorBrush x:Key="CardAltBrush" Color="#26263A" />
        <SolidColorBrush x:Key="AccentBrush" Color="#7C5CFF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9A9AB0" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2F2F7" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardAltBrush}" />
            <Setter Property="Foreground" Value="#F2F2F7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#34344C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource CardAltBrush}" />
            <Setter Property="Foreground" Value="#F2F2F7" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F2F2F7" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="250" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="AudioFlow" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="Elige una aplicación → elige dónde quieres escucharla"
                           Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="14,0,0,5" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#6B6B80" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RoutingEnabled}" Value="True">
                                    <Setter Property="Fill" Value="#38D39F" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button Content="Aplicar ahora" Command="{Binding ApplyNowCommand}" Margin="0,0,8,0" />
                <Button Content="Actualizar" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                <Button Content="{Binding StartStopText}" Command="{Binding StartStopCommand}"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Grid>

        <!-- Main sections -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Speakers -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="&#x1F50A;  PARLANTES" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Solo estas aplicaciones sonarán aquí." Style="{StaticResource Muted}" />
                        <ComboBox Margin="0,12,0,0" ItemsSource="{Binding OutputDevices}"
                                  SelectedItem="{Binding SpeakersDevice}" DisplayMemberPath="DisplayName" />
                        <CheckBox Content="Audio Lock (bloquear este dispositivo)"
                                  IsChecked="{Binding AudioLockEnabled}" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="Aplicaciones permitidas" Style="{StaticResource Muted}"
                               Margin="0,16,0,6" />

                    <ListBox Grid.Row="2" ItemsSource="{Binding SpeakerApps}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardAltBrush}" CornerRadius="10"
                                        Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Key}" Style="{StaticResource Muted}" />
                                        </StackPanel>
                                        <Button Content="Quitar" HorizontalAlignment="Right" Padding="10,4"
                                                Command="{Binding DataContext.RemoveFromSpeakersCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Headphones -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="&#x1F3A7;  AUDÍFONOS" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Todo lo demás se envía aquí." Style="{StaticResource Muted}" />
                        <ComboBox Margin="0,12,0,0" ItemsSource="{Binding OutputDevices}"
                                  SelectedItem="{Binding HeadphonesDevice}" DisplayMemberPath="DisplayName" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="{StaticResource CardAltBrush}" CornerRadius="10"
                            Padding="14" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Regla por defecto" Style="{StaticResource Muted}" />
                            <TextBlock Text="Todo lo demás" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0" />
                            <TextBlock Margin="0,6,0,0">
                                <Run Text="Salida:" Foreground="#9A9AB0" />
                                <Run Text="{Binding HeadphonesDeviceName, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <TextBlock Text="Aplicaciones detectadas" Style="{StaticResource SectionTitle}" FontSize="15" />
                        <TextBlock Text="Pulsa '+' para permitir que una app use los parlantes."
                                   Style="{StaticResource Muted}" />
                        <ListBox ItemsSource="{Binding DetectedApps}" Background="Transparent"
                                 BorderThickness="0" Margin="0,8,0,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardAltBrush}" CornerRadius="10"
                                            Padding="12,8" Margin="0,0,0,6">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" />
                                            </StackPanel>
                                            <Button HorizontalAlignment="Right" Padding="10,4"
                                                    Command="{Binding DataContext.AddToSpeakersCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Content" Value="+ Parlantes" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnSpeakers}" Value="True">
                                                                <Setter Property="Content" Value="&#x2713; Parlantes" />
                                                                <Setter Property="IsEnabled" Value="False" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Log -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Registro" Style="{StaticResource SectionTitle}" FontSize="15" />
                <ListBox Grid.Row="1" ItemsSource="{Binding LogLines}" Background="Transparent"
                         BorderThickness="0" FontFamily="Consolas" FontSize="11"
                         Foreground="#B9B9CC" />
            </Grid>
        </Border>
    </Grid>
</Window>
