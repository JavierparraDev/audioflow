<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Company>AudioFlow</Company>
    <Product>AudioFlow</Product>
    <Copyright>Copyright (c) 2026 Javier Parra</Copyright>

    <!--
      Single source of truth for the application version.
      Everything (executable metadata, UI, CLI, installer, updater) reads this.
      Bump with semantic versioning: MAJOR.MINOR.PATCH (e.g. 0.2.0, 1.0.0).
    -->
    <Version>0.2.0</Version>

    <!--
      Allows building Windows-targeted projects (net8.0-windows, NAudio, WPF)
      from a non-Windows host (CI / Linux) by restoring the Windows targeting
      packs from NuGet. Runtime execution still requires Windows.
    -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
